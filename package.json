{
  "name": "thicket",
  "version": "0.1.0",
  "description": "Deterministic complexity reports for TypeScript codebases",
  "type": "module",
  "bin": { "thicket": "./dist/cli.js" },
  "engines": { "node": ">=24" },
  "scripts": {
