    "test:watch": "vitest"
  },
  "dependencies": {
    "typescript": "7.1.0-dev.20260808.1",
    "xxhash-wasm": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^3.0.0"
  }
}
