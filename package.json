{
  "name": "thicket",
  "version": "0.1.0",
  "description": "Deterministic complexity reports for TypeScript codebases",
  "type": "module",
  "bin": {
    "thicket": "./dist/cli.js"
  },
  "engines": {
    "bun": ">=1.4",
    "node": ">=24"
  },
  "scripts": {
    "thicket": "bun src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "site:build": "bun site/build.mjs"
  },
  "dependencies": {
    "typescript": "7.1.0-dev.20260808.1",
    "xxhash-wasm": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^3.0.0"
  }
}
