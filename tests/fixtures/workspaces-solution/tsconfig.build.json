{
  // A root-level sibling that reaches INTO a workspace. Nothing should pick it
  // up: the root's coverage check is scoped to files in no workspace, and every
  // file this config names belongs to `tools/alpha`. Scope that check to the
  // whole tree instead and this config starts looking like the thing that
  // covers `tools/alpha` -- which is the mistake it exists to catch.
  "compilerOptions": { "target": "es2022", "module": "nodenext", "moduleResolution": "nodenext", "strict": true, "noEmit": true },
  "include": ["tools/**/*.ts"]
}
